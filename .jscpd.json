{
  "threshold": 3,
  "reporters": ["console"],
  "absolute": true,
  "gitignore": true,
  "format": ["typescript", "tsx", "javascript", "jsx"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/dist/**",
    "**/coverage/**",
    "**/report/**",
    "types/validator.ts",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
