{
  "$schema": "https://unpkg.com/knip@5/schemas/knip.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "features/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "project": [
    "app/**/*.{ts,tsx,css}",
    "components/**/*.{ts,tsx}",
    "features/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "types/**/*.ts",
    "*.config.{js,cjs,mjs,ts}"
  ],
  "ignore": ["types/validator.ts"],
  "ignoreBinaries": ["pkill"],
  "ignoreDependencies": [
    "@emnapi/core",
    "@emnapi/runtime",
    "eslint-config-next",
    "ts-jest"
  ]
}
