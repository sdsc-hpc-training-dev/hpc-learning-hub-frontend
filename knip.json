{
  "$schema": "https://unpkg.com/knip@5/schemas/knip.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "types/**/*.ts",
    "*.config.{js,cjs,mjs,ts}"
  ],
  "ignore": [
    "types/validator.ts",
    "components/ui/Dialog.tsx",
    "components/ui/MaterialCard.tsx",
    "components/ui/ResourseLink.tsx",
    "components/ui/StatusMessage.tsx",
    "lib/gateway/client.ts",
    "lib/gateway/types.ts",
    ".next/**",
    "coverage/**",
    "report/**"
  ],
  "ignoreDependencies": [
    "@emnapi/core",
    "@emnapi/runtime",
    "@next/eslint-plugin-next",
    "eslint-config-next",
    "tailwindcss",
    "ts-jest"
  ]
}